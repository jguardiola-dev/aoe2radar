<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml: la descripción del proyecto para Maven. Sustituye a crear_exe.bat como fuente de verdad. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.tirador</groupId>
  <artifactId>aoe2radar</artifactId>
  <version>1.2.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>aoe2radar</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flatlaf.version>3.7.2</flatlaf.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- el harness de capturas necesita pantalla: en Windows la hay; en CI se usa -Djava.awt.headless=false con un escritorio virtual -->
          <argLine>-Duser.language=es -Dfile.encoding=UTF-8 -Djava.awt.headless=false</argLine>
          <!-- la app lee y escribe con rutas relativas (config.properties, sfrdata/, banderas/, techtree/):
               en el test trabaja en target/harness para no ensuciar la raíz del repo -->
          <workingDirectory>${project.build.directory}/harness</workingDirectory>
          <!-- una JVM limpia por clase de test: si otro test inicializa Java2D antes que la app, el escalado de iconos cambia píxeles -->
          <reuseForks>false</reuseForks>
          <!-- surefire solo recoge *Test/Test*/*Tests/*TestCase: RegresionCapturas hay que nombrarlo -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/RegresionCapturas.java</include>
          </includes>
          <systemPropertyVariables>
            <basedir>${project.basedir}</basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>SpoilerFreeRecs</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- Fase 4: plugin de jpackage (por ejemplo org.panteleyev:jpackage-maven-plugin) para generar el exe con runtime, como hacía crear_exe.bat -->
    </plugins>
  </build>
</project>
